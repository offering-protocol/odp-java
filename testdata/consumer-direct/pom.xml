<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.offeringprotocol.example</groupId>
  <artifactId>odp-java-direct-version-consumer</artifactId>
  <version>1.0.0</version>

  <properties>
    <odp.version>0.2.1</odp.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.offeringprotocol</groupId>
      <artifactId>odp-json-jackson2</artifactId>
      <version>${odp.version}</version>
    </dependency>
    <dependency>
      <groupId>org.offeringprotocol</groupId>
      <artifactId>odp-core</artifactId>
      <version>${odp.version}</version>
    </dependency>
    <dependency>
      <groupId>org.offeringprotocol</groupId>
      <artifactId>odp-directory</artifactId>
      <version>${odp.version}</version>
    </dependency>
    <dependency>
      <groupId>org.offeringprotocol</groupId>
      <artifactId>odp-agent</artifactId>
      <version>${odp.version}</version>
    </dependency>
    <dependency>
      <groupId>org.offeringprotocol</groupId>
      <artifactId>odp-service</artifactId>
      <version>${odp.version}</version>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>../consumer/src/main/java</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>
    </plugins>
  </build>
</project>
